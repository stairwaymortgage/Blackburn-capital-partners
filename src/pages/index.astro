---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CredentialsStrip from '../components/CredentialsStrip.astro';
---
<BaseLayout title="Blackburn Capital Partners | Private Hotel Acquisitions">
  <Header variant="full" />

  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg-pattern"></div>
    <div class="hero-bg-glow"></div>
    <div class="hero-bg-glow-2"></div>
    <div class="hero-inner">
      <div class="hero-left">
        <div class="hero-eyebrow">
          <div class="hero-eyebrow-line"></div>
          <div class="hero-eyebrow-text">Fort Lauderdale &nbsp;&middot;&nbsp; Private Hotel Acquisitions</div>
        </div>
        <h1 class="hero-headline">
          We Find the Deals <em>Nobody Else</em> Sees Coming.
        </h1>
        <p class="hero-body">
          Blackburn Capital Partners sources distressed and off-market hotels across the
          Sun Belt Coastal Crescent &mdash; connecting motivated sellers to a private
          network of conversion operators and accredited investors. Quietly. Directly.
          Off-market.
        </p>
        <div class="hero-btns">
          <a href="#investors" class="btn-primary">Join Our Private Network</a>
          <a href="#sellers" class="btn-ghost">Sell Your Hotel</a>
        </div>
      </div>
      <div class="hero-photo-wrap">
        <div class="hero-gold-rule"></div>
        <div class="hero-photo-card">
          <img src="/images/jim-blackburn.png" alt="Jim Blackburn" class="hero-photo" />
          <div class="hero-photo-badge">
            <div class="hero-photo-name">Jim Blackburn</div>
            <div class="hero-photo-title">Founder &nbsp;&middot;&nbsp; Blackburn Capital Partners</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CredentialsStrip />

  <!-- TWO DOORS -->
  <section class="section" id="deals">
    <div class="section-inner">
      <div class="section-eyebrow">
        <div class="section-eyebrow-line"></div>
        <div class="section-eyebrow-text">Who We Serve</div>
      </div>
      <h2 class="section-headline">Two Doors. <em>One Conversation.</em></h2>
      <p class="section-sub">
        We operate a private two-sided marketplace connecting distressed hotel owners
        with qualified conversion operators and accredited investors across the
        Southeast United States.
      </p>

      <div class="doors" id="sellers">
        <div class="door-card seller">
          <div class="door-number">01</div>
          <div class="door-label">For Hotel Owners</div>
          <h3 class="door-headline">Ready to Exit Your Hotel?</h3>
          <p class="door-body">
            If you own a distressed, aging, or underperforming hotel and you want a
            quiet, fast, no-commission exit &mdash; we want to hear from you. No
            broker. No MLS listing. No strangers walking through your property.
          </p>
          <ul class="door-list">
            <li>Offer in 72 hours &mdash; multiple structures available</li>
            <li>Close in 30 to 90 days, your timeline</li>
            <li>No MLS listing. No public marketing.</li>
            <li>As-is purchase &mdash; no repairs required</li>
            <li>Confidential. Off-market. Private.</li>
          </ul>
          <a href="/sellers" class="btn-navy">Get a Confidential Offer</a>
        </div>

        <div class="door-card investor" id="investors">
          <div class="door-number">02</div>
          <div class="door-label">For Investors</div>
          <h3 class="door-headline">Access Deals Before They Hit the Market.</h3>
          <p class="door-body">
            We originate proprietary off-market hotel acquisitions across the Sun Belt
            Coastal Crescent and present them exclusively to our private network of
            conversion operators and accredited investors before anyone else sees them.
          </p>
          <ul class="door-list">
            <li>Off-market distressed hotel deal flow</li>
            <li>Pre-underwritten acquisition packages</li>
            <li>Sun Belt Coastal Crescent focus</li>
            <li>Conversion-ready hotel inventory</li>
            <li>Private network &mdash; application required</li>
          </ul>
          <a href="/investors" class="btn-crimson">Join the Private Network</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="about-strip" id="about">
    <div class="about-inner">
      <div class="about-photo-wrap">
        <div class="about-photo-frame">
          <img
            src="/images/jim-olga-construction.jpg"
            alt="Jim and Olga Blackburn in front of Fort Lauderdale construction skyline"
            class="about-photo"
          />
        </div>
        <div class="about-gold-accent"></div>
        <div class="about-photo-caption">Jim and Olga Blackburn &middot; Fort Lauderdale, Florida</div>
      </div>
      <div class="about-content">
        <div class="section-eyebrow">
          <div class="section-eyebrow-line"></div>
          <div class="section-eyebrow-text">About Our Team</div>
        </div>
        <h2 class="section-headline">The Team That Finds <em>the Deals.</em></h2>
        <p class="about-body">
          Blackburn Capital Partners is led by Jim Blackburn &mdash; a Fort Lauderdale
          based commercial capital markets professional with
          <strong>seven consecutive years as a Scotsman Guide Top 1% producer.</strong>
          Behind him stands a family enterprise and an experienced team of attorneys,
          CPAs, asset managers, and construction professionals built specifically for
          the Sun Belt hotel acquisition thesis.
        </p>
        <p class="about-body">
          We started Blackburn Capital Partners with one thesis:
          <strong>the most valuable real estate in any deal is the deal itself.</strong>
          Most distressed hotels never reach a broker. Most conversion opportunities
          never reach the right operator. We sit in the middle &mdash; finding what
          others miss and delivering it to the people who can act.
        </p>
        <p class="about-body">
          We are not a fund. We do not run a six-percent listing service.
          <strong>We are a capital markets team with a private network and the
          discipline to find deals nobody else is looking for.</strong>
        </p>
        <div class="about-stats">
          <div class="stat-item">
            <div class="stat-number">7<span>&times;</span></div>
            <div class="stat-label">Scotsman Guide<br />Top 1% Producer</div>
          </div>
          <div class="stat-item">
            <div class="stat-number">15<span>+</span></div>
            <div class="stat-label">Years Commercial<br />Capital Markets</div>
          </div>
          <div class="stat-item">
            <div class="stat-number">6<span></span></div>
            <div class="stat-label">Sun Belt<br />Coastal States</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TERRITORY -->
  <section class="geography" id="territory">
    <div class="geography-inner">
      <div class="section-eyebrow">
        <div class="section-eyebrow-line"></div>
        <div class="section-eyebrow-text" style="color:var(--gold);">Our Territory</div>
      </div>
      <h2 class="section-headline">The Sun Belt <em>Coastal Crescent.</em></h2>
      <p class="section-sub">
        We operate exclusively along the Southeast coastal corridor &mdash; from the
        Gulf Coast of Mississippi through Florida and up the Atlantic shore to coastal
        North Carolina. Six states. One focused thesis.
      </p>
      <div class="geo-grid">
        <div class="geo-item">
          <div class="geo-state">Florida</div>
          <div class="geo-detail">Fort Lauderdale &middot; Miami &middot; Tampa &middot; Orlando &middot; Jacksonville &middot; Sarasota &middot; Daytona</div>
          <div class="geo-status active">&#9679; Primary Market</div>
        </div>
        <div class="geo-item">
          <div class="geo-state">Georgia</div>
          <div class="geo-detail">Savannah &middot; Brunswick &middot; Atlanta Metro &middot; Golden Isles Corridor</div>
          <div class="geo-status active">&#9679; Primary Market</div>
        </div>
        <div class="geo-item">
          <div class="geo-state">South Carolina</div>
          <div class="geo-detail">Myrtle Beach &middot; Charleston &middot; Hilton Head &middot; Columbia &middot; Coastal Corridor</div>
          <div class="geo-status active">&#9679; Primary Market</div>
        </div>
        <div class="geo-item">
          <div class="geo-state">North Carolina</div>
          <div class="geo-detail">Wilmington &middot; Outer Banks &middot; Crystal Coast &middot; Charlotte Metro</div>
          <div class="geo-status tier2">&#9675; Secondary Market</div>
        </div>
        <div class="geo-item">
          <div class="geo-state">Alabama</div>
          <div class="geo-detail">Gulf Shores &middot; Orange Beach &middot; Mobile &middot; Gulf Coast Corridor</div>
          <div class="geo-status tier2">&#9675; Secondary Market</div>
        </div>
        <div class="geo-item">
          <div class="geo-state">Mississippi</div>
          <div class="geo-detail">Biloxi &middot; Gulfport &middot; Ocean Springs &middot; Gulf Coast Gaming Corridor</div>
          <div class="geo-status tier2">&#9675; Secondary Market</div>
        </div>
      </div>
    </div>
  </section>

  <!-- SIGNUP -->
  <section class="signup-section" id="contact">
    <div class="signup-inner">
      <div class="section-eyebrow">
        <div class="section-eyebrow-line"></div>
        <div class="section-eyebrow-text">Join the Network</div>
      </div>
      <h2 class="section-headline">Get On the <em>Private List.</em></h2>
      <p class="section-sub">
        We share off-market hotel acquisition opportunities exclusively with our private
        network. Access is by application only. Tell us who you are and what you're
        looking for.
      </p>

      <form class="signup-form">
        <div class="form-group">
          <label class="form-label">First Name</label>
          <input type="text" class="form-input" placeholder="James" />
        </div>
        <div class="form-group">
          <label class="form-label">Last Name</label>
          <input type="text" class="form-input" placeholder="Blackburn" />
        </div>
        <div class="form-group">
          <label class="form-label">Email Address</label>
          <input type="email" class="form-input" placeholder="you@example.com" />
        </div>
        <div class="form-group">
          <label class="form-label">Phone Number</label>
          <input type="tel" class="form-input" placeholder="(954) 000-0000" />
        </div>
        <div class="form-group full">
          <label class="form-label">I Am A...</label>
          <select class="form-select">
            <option>Accredited Investor</option>
            <option>Hotel Conversion Operator</option>
            <option>Family Office / Fund</option>
            <option>Hotel Owner Looking to Exit</option>
            <option>Other</option>
          </select>
        </div>
        <div class="form-group full">
          <label class="form-label">Acquisition Criteria / Message</label>
          <textarea class="form-input" rows="4" placeholder="Tell us what you're looking for &mdash; deal size, geography, asset type..."></textarea>
        </div>
      </form>
      <button class="form-submit">Request Private Network Access</button>
      <p class="form-disclaimer">
        This is not a public offering. All opportunities are presented exclusively to
        qualified accredited investors and conversion operators. Blackburn Capital
        Partners &middot; Fort Lauderdale, FL &middot; blackburn.capital
      </p>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  /* ── HERO ── */
  .hero {
    min-height: 100vh;
    background: var(--navy-deep);
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
    padding-top: 64px;
  }

  .hero-bg-pattern {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(201, 168, 76, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(201, 168, 76, 0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    pointer-events: none;
  }

  .hero-bg-glow {
    position: absolute;
    top: -100px;
    right: -100px;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(139, 26, 26, 0.08) 0%, transparent 65%);
    pointer-events: none;
  }

  .hero-bg-glow-2 {
    position: absolute;
    bottom: -150px;
    left: 200px;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(30, 42, 58, 0.6) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px 32px;
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 60px;
    align-items: center;
    position: relative;
    z-index: 2;
    width: 100%;
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 28px;
    animation: fadeUp 0.8s ease both;
  }

  .hero-eyebrow-line {
    width: 32px;
    height: 1px;
    background: var(--crimson);
    flex-shrink: 0;
  }

  .hero-eyebrow-text {
    font-size: 0.6rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--gold);
    font-weight: 600;
  }

  .hero-headline {
    font-family: 'Playfair Display', serif;
    font-size: 3.2rem;
    font-weight: 700;
    line-height: 1.08;
    color: var(--white);
    margin-bottom: 28px;
    animation: fadeUp 0.8s 0.1s ease both;
  }

  .hero-headline em {
    font-style: italic;
    color: var(--gold);
  }

  .hero-body {
    font-size: 0.95rem;
    line-height: 1.85;
    color: rgba(255, 255, 255, 0.85);
    max-width: 480px;
    margin-bottom: 40px;
    font-weight: 300;
    animation: fadeUp 0.8s 0.2s ease both;
  }

  .hero-btns {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    animation: fadeUp 0.8s 0.3s ease both;
  }

  .hero-photo-wrap {
    position: relative;
    animation: fadeUp 0.8s 0.4s ease both;
  }

  .hero-photo-card {
    background: var(--navy);
    border: 1px solid rgba(201, 168, 76, 0.2);
    position: relative;
    overflow: hidden;
  }

  .hero-photo-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--crimson), var(--gold));
    z-index: 2;
  }

  .hero-photo {
    width: 100%;
    display: block;
    filter: contrast(1.02) saturate(0.95);
  }

  .hero-photo-badge {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgba(20, 30, 43, 0.98) 0%, transparent 100%);
    padding: 32px 24px 24px;
  }

  .hero-photo-name {
    font-family: 'Playfair Display', serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--white);
    margin-bottom: 4px;
  }

  .hero-photo-title {
    font-size: 0.58rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
    font-weight: 600;
  }

  .hero-gold-rule {
    position: absolute;
    left: -16px;
    top: 40px;
    width: 3px;
    height: 80px;
    background: linear-gradient(to bottom, var(--gold), transparent);
  }

  /* ── TWO DOOR CARDS ── */
  .doors {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    background: var(--border);
  }

  .door-card {
    background: var(--white);
    padding: 48px 40px;
    position: relative;
    overflow: hidden;
    transition: transform 0.3s;
  }

  .door-card:hover { transform: translateY(-4px); }

  .door-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
  }

  .door-card.seller::before { background: var(--navy); }
  .door-card.investor::before { background: var(--crimson); }

  .door-number {
    font-family: 'Playfair Display', serif;
    font-size: 3.5rem;
    font-weight: 700;
    color: var(--navy-10);
    line-height: 1;
    margin-bottom: 20px;
  }

  .door-card.investor .door-number { color: rgba(139, 26, 26, 0.06); }

  .door-label {
    font-size: 0.58rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    margin-bottom: 16px;
    font-weight: 700;
    white-space: nowrap;
  }

  .door-card.seller .door-label { color: var(--navy); }
  .door-card.investor .door-label { color: var(--crimson); }

  .door-headline {
    font-family: 'Playfair Display', serif;
    font-size: 1.7rem;
    font-weight: 600;
    color: var(--navy);
    margin-bottom: 20px;
    line-height: 1.2;
  }

  .door-body {
    font-size: 0.9rem;
    line-height: 1.8;
    color: #555;
    font-weight: 400;
    margin-bottom: 32px;
  }

  .door-list {
    list-style: none;
    margin-bottom: 36px;
  }

  .door-list li {
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--charcoal);
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 500;
  }

  .door-list li::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .door-card.seller .door-list li::before { background: var(--navy); }
  .door-card.investor .door-list li::before { background: var(--crimson); }

  /* ── ABOUT STRIP ── */
  .about-strip {
    background: var(--off-white);
    padding: 100px 32px;
    border-top: 1px solid var(--border);
  }

  .about-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 64px;
    align-items: start;
  }

  .about-photo-wrap { position: relative; }

  .about-photo {
    width: 100%;
    display: block;
    filter: contrast(1.05) saturate(1);
  }

  .about-photo-frame {
    border: 1px solid var(--border);
    overflow: hidden;
    position: relative;
    background: white;
  }

  .about-photo-frame::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--navy), var(--crimson));
  }

  .about-gold-accent {
    position: absolute;
    top: -8px;
    right: -8px;
    width: 32px;
    height: 32px;
    border-top: 3px solid var(--gold);
    border-right: 3px solid var(--gold);
  }

  .about-photo-caption {
    margin-top: 16px;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: #777;
    font-style: italic;
    text-align: center;
    line-height: 1.6;
    font-weight: 400;
  }

  .about-content { padding-top: 8px; }
  .about-content .section-eyebrow { margin-bottom: 16px; }

  .about-content .section-headline {
    font-size: 2rem;
    margin-bottom: 24px;
  }

  .about-body {
    font-size: 0.95rem;
    line-height: 1.9;
    color: #444;
    font-weight: 400;
    margin-bottom: 22px;
  }

  .about-body strong {
    color: var(--navy);
    font-weight: 600;
  }

  .about-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 48px;
    padding-top: 40px;
    border-top: 1px solid var(--border);
  }

  .stat-number {
    font-family: 'Playfair Display', serif;
    font-size: 3.4rem;
    font-weight: 700;
    color: var(--navy);
    line-height: 1;
    margin-bottom: 12px;
  }

  .stat-number span {
    color: var(--crimson);
    font-size: 2.2rem;
  }

  .stat-label {
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #555;
    font-weight: 600;
    line-height: 1.5;
  }

  /* ── GEOGRAPHY ── */
  .geography {
    padding: 100px 32px;
    background: var(--navy-deep);
    position: relative;
    overflow: hidden;
  }

  .geography::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(201, 168, 76, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(201, 168, 76, 0.02) 1px, transparent 1px);
    background-size: 60px 60px;
    pointer-events: none;
  }

  .geography-inner {
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .geography .section-headline { color: var(--white); }
  .geography .section-sub {
    color: rgba(255, 255, 255, 0.85);
    font-weight: 300;
  }

  .geo-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    background: rgba(255, 255, 255, 0.04);
    margin-top: 48px;
  }

  .geo-item {
    background: rgba(20, 30, 43, 0.85);
    padding: 32px 28px;
    border-bottom: 2px solid transparent;
    transition: border-color 0.2s;
  }

  .geo-item:hover { border-bottom-color: var(--crimson); }

  .geo-state {
    font-family: 'Playfair Display', serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--white);
    margin-bottom: 12px;
  }

  .geo-detail {
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.7);
    font-weight: 400;
    line-height: 1.7;
  }

  .geo-status {
    margin-top: 18px;
    font-size: 0.58rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 700;
  }

  .geo-status.active { color: var(--gold); }
  .geo-status.tier2 { color: rgba(255, 255, 255, 0.55); }

  /* ── SIGNUP SECTION ── */
  .signup-section {
    background: var(--white);
    padding: 100px 32px;
    border-top: 1px solid var(--border);
  }

  .signup-inner {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  .signup-inner :global(.section-eyebrow) { justify-content: center; }

  .signup-inner :global(.section-headline) {
    font-size: 2.2rem;
    margin-bottom: 16px;
  }

  .signup-inner :global(.section-sub) {
    max-width: 100%;
    text-align: center;
    margin-bottom: 48px;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 1024px) {
    .geo-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 768px) {
    .hero { padding-top: 60px; min-height: auto; }
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 48px;
      padding: 60px 24px;
    }
    .hero-headline { font-size: 2.4rem; }
    .hero-body { font-size: 0.95rem; }
    .hero-btns { flex-direction: column; align-items: stretch; }
    .hero-btns :global(a) { text-align: center; }

    .hero-photo-wrap { max-width: 320px; margin: 0 auto; width: 100%; }
    .hero-gold-rule { display: none; }

    .doors { grid-template-columns: 1fr; gap: 16px; background: transparent; }
