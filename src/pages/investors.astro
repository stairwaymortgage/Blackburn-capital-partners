---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const quickLinks = [
  { label: 'Home', href: '/' },
  { label: 'Apply for Network Access', href: '#apply' },
  { label: 'Call (954) 824-1894', href: 'tel:9548241894' },
];
---
<BaseLayout
  title="Private Hotel Deal Flow | Blackburn Capital Partners"
  description="Off-market hotel acquisitions for accredited investors and conversion operators across the Sun Belt Coastal Crescent. By application only."
>
  <Header variant="minimal" />

  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg-pattern"></div>
    <div class="hero-bg-glow"></div>
    <div class="hero-inner">
      <div class="hero-left">
        <div class="hero-eyebrow">
          <div class="hero-eyebrow-line"></div>
          <div class="hero-eyebrow-text">For Accredited Investors &amp; Operators</div>
        </div>
        <h1 class="hero-headline">
          Off-Market Hotel Deals <em>Before Anyone Else Sees Them.</em>
        </h1>
        <p class="hero-body">
          We source proprietary, distressed and underperforming hotel acquisitions
          across the Sun Belt Coastal Crescent and present them exclusively to a
          private network of accredited investors and conversion operators. No auctions.
          No MLS. No bidding wars. Access is by application only.
        </p>
        <div class="hero-btns">
          <a href="#apply" class="btn-primary">Apply for Network Access</a>
          <a href="tel:9548241894" class="btn-phone-large">Call (954) 824-1894</a>
        </div>
      </div>
      <div class="hero-photo-card">
        <img src="/images/jim-blackburn.png" alt="Jim Blackburn" class="hero-photo" />
        <div class="hero-photo-badge">
          <div class="hero-photo-name">Jim Blackburn</div>
          <div class="hero-photo-title">Founder &middot; Blackburn Capital Partners</div>
        </div>
      </div>
    </div>
  </section>

  <!-- STATS BAR -->
  <div class="stats-bar">
    <div class="stats-inner">
      <div class="stat-block">
        <div class="stat-num">$50M<span>+</span></div>
        <div class="stat-text">Active Hotel<br />Deal Pipeline</div>
      </div>
      <div class="stat-block">
        <div class="stat-num">6</div>
        <div class="stat-text">Sun Belt<br />Coastal States</div>
      </div>
      <div class="stat-block">
        <div class="stat-num">7<span>&times;</span></div>
        <div class="stat-text">Scotsman Guide<br />Top 1% Producer</div>
      </div>
      <div class="stat-block">
        <div class="stat-num">100<span>%</span></div>
        <div class="stat-text">Off-Market<br />Sourcing</div>
      </div>
    </div>
  </div>

  <!-- THESIS -->
  <section class="section cream">
    <div class="section-inner">
      <div class="section-eyebrow">
        <div class="section-eyebrow-line"></div>
        <div class="section-eyebrow-text">Our Thesis</div>
      </div>
      <h2 class="section-headline">Three Reasons This Asset Class <em>Works Right Now.</em></h2>
      <p class="section-sub">
        The Sun Belt coastal hotel market is experiencing structural distress at the
        same moment multifamily rents are at historic highs. We sit at the intersection
        of those two trends.
      </p>

      <div class="thesis-grid">
        <div class="thesis-card">
          <div class="thesis-num">01</div>
          <div class="thesis-headline">Distressed Hotel Supply</div>
          <p class="thesis-body">
            Sun Belt hotel owners are facing rising insurance, deferred CapEx, and
            post-pandemic occupancy gaps. Many are tired, retiring, or undercapitalized.
            Aged-out exterior corridor hotels especially are coming available at
            significant discounts to replacement cost.
          </p>
        </div>
        <div class="thesis-card">
          <div class="thesis-num">02</div>
          <div class="thesis-headline">Conversion Economics</div>
          <p class="thesis-body">
            Hotel rooms convert to studio and one-bedroom multifamily units at roughly
            half the cost of ground-up construction. With Sun Belt rents at all-time
            highs, the math on hotel-to-residential conversion has never been stronger.
          </p>
        </div>
        <div class="thesis-card">
          <div class="thesis-num">03</div>
          <div class="thesis-headline">Off-Market Sourcing Edge</div>
          <p class="thesis-body">
            Our pipeline is direct-from-owner, sourced through proprietary outreach to
            AAHOA hotel owners and Sun Belt operators who have never received a serious
            offer. No CoStar listings. No broker auctions. No competitive bidding.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CRITERIA -->
  <section class="section">
    <div class="section-inner">
      <div class="section-eyebrow">
        <div class="section-eyebrow-line"></div>
        <div class="section-eyebrow-text">What We Source</div>
      </div>
      <h2 class="section-headline">Acquisition Criteria <em>&amp; Target Profile.</em></h2>
      <p class="section-sub">
        We focus our sourcing on a specific type of hotel asset. The targets that match
        every criterion below tend to convert to multifamily at the highest yield.
      </p>

      <div class="criteria-table">
        <div class="criteria-row">
          <div class="criteria-label">Geography</div>
          <div class="criteria-value">
            <strong>Sun Belt Coastal Crescent</strong> &mdash; Florida, Georgia, South
            Carolina primary; North Carolina, Alabama, Mississippi secondary
          </div>
        </div>
        <div class="criteria-row">
          <div class="criteria-label">Asset Type</div>
          <div class="criteria-value">
            <strong>Limited-service or extended-stay hotels</strong> &mdash; typically
            1980s-2000s exterior corridor builds, 80 to 400 keys
          </div>
        </div>
        <div class="criteria-row">
          <div class="criteria-label">Deal Size</div>
          <div class="criteria-value">
            <strong>$10M to $75M</strong> all-in basis &mdash; including acquisition,
            conversion CapEx, and stabilization reserves
          </div>
        </div>
        <div class="criteria-row">
          <div class="criteria-label">Condition</div>
          <div class="criteria-value">
            <strong>Distressed, dated, or underperforming</strong> &mdash; flag dropped
            or in good standing, deferred CapEx acceptable, conversion-ready layouts
            preferred
          </div>
        </div>
        <div class="criteria-row">
          <div class="criteria-label">Submarket</div>
          <div class="criteria-value">
            <strong>Strong rental demand</strong> &mdash; we underwrite to local Class
            B-C multifamily rents, walkable to employment and transit when possible
          </div>
        </div>
        <div class="criteria-row">
          <div class="criteria-label">Capital Stack</div>
          <div class="criteria-value">
            <strong>Bridge debt to HUD 223(f) takeout</strong> &mdash; pre-arranged
            construction debt available, equity from accredited LPs in our network
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section dark">
    <div class="section-inner">
      <div class="section-eyebrow">
        <div class="section-eyebrow-line"></div>
        <div class="section-eyebrow-text">How It Works</div>
      </div>
      <h2 class="section-headline">From Application <em>to Allocation.</em></h2>
      <p class="section-sub">
        Network access is by application. Once you are in, deal flow is consistent,
        pre-underwritten, and presented before anything hits the public market.
      </p>

      <div class="timeline">
        <div class="timeline-step">
          <div class="timeline-num">01</div>
          <div class="timeline-headline">Apply</div>
          <p class="timeline-body">
            Submit the network access application with your accreditation status, deal
            preferences, and check size.
          </p>
        </div>
        <div class="timeline-step">
          <div class="timeline-num">02</div>
          <div class="timeline-headline">Intro Call</div>
          <p class="timeline-body">
            30-minute private call. We learn your investment thesis. You learn how our
            pipeline works and what to expect.
          </p>
        </div>
        <div class="timeline-step">
          <div class="timeline-num">03</div>
          <div class="timeline-headline">Deal Flow</div>
          <p class="timeline-body">
            Pre-underwritten acquisition packages arrive in your inbox before they hit
            any public market. Pass or proceed.
          </p>
        </div>
        <div class="timeline-step">
          <div class="timeline-num">04</div>
          <div class="timeline-headline">Allocation</div>
          <p class="timeline-body">
            Subscribe to the SPV for the specific deal. Capital call, close, and start
            receiving distributions per the operating agreement.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FORM -->
  <section class="form-section" id="apply">
    <div class="form-inner">
      <div class="section-eyebrow">
        <div class="section-eyebrow-line"></div>
        <div class="section-eyebrow-text">Request Network Access</div>
      </div>
      <h2 class="section-headline">Apply to <em>the Network.</em></h2>
      <p class="section-sub">
        Access is by application. We work exclusively with accredited investors,
        qualified family offices, and proven conversion operators. Tell us about
        yourself and what you are looking for.
      </p>

      <form class="signup-form">
        <div class="form-group">
          <label class="form-label">First Name</label>
          <input type="text" class="form-input" placeholder="Your first name" />
        </div>
        <div class="form-group">
          <label class="form-label">Last Name</label>
          <input type="text" class="form-input" placeholder="Your last name" />
        </div>
        <div class="form-group">
          <label class="form-label">Email</label>
          <input type="email" class="form-input" placeholder="you@firm.com" />
        </div>
        <div class="form-group">
          <label class="form-label">Phone</label>
          <input type="tel" class="form-input" placeholder="(000) 000-0000" />
        </div>
        <div class="form-group">
          <label class="form-label">I Am A</label>
          <select class="form-select">
            <option>Accredited Individual Investor</option>
            <option>Family Office</option>
            <option>RIA / Wealth Manager</option>
            <option>Conversion Operator</option>
            <option>Hotel Operator</option>
            <option>Real Estate Fund</option>
            <option>Other</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Target Check Size</label>
          <select class="form-select">
            <option>$100K to $250K</option>
            <option>$250K to $500K</option>
            <option>$500K to $1M</option>
            <option>$1M to $5M</option>
            <option>$5M+</option>
          </select>
        </div>
        <div class="form-group full">
          <label class="form-label">Investment Criteria / Message</label>
          <textarea class="form-input" rows="4" placeholder="Geography preferences, asset types, return targets, hold period preferences..."></textarea>
        </div>
      </form>
      <button class="form-submit">Submit Network Application</button>
      <p class="form-disclaimer">
        This is not a public offering. All opportunities are presented exclusively to
        qualified accredited investors as defined under SEC Rule 501. Past performance
        does not guarantee future results. Blackburn Capital Partners &middot; Fort
        Lauderdale, FL
      </p>
    </div>
  </section>

  <Footer quickLinks={quickLinks} emailLinkHref="#apply" />
</BaseLayout>

<style>
  .hero {
    background: var(--navy-deep);
    padding: 120px 32px 80px;
    position: relative;
    overflow: hidden;
  }

  .hero-bg-pattern {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(201, 168, 76, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(201, 168, 76, 0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    pointer-events: none;
  }

  .hero-bg-glow {
    position: absolute;
    top: -100px;
    right: -100px;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(201, 168, 76, 0.06) 0%, transparent 65%);
    pointer-events: none;
  }

  .hero-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 320px 1.2fr;
    gap: 56px;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  .hero-left { grid-column: 2; grid-row: 1; }
  .hero-photo-card { grid-column: 1; grid-row: 1; }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 28px;
  }

  .hero-eyebrow-line {
    width: 32px;
    height: 1px;
    background: var(--crimson);
    flex-shrink: 0;
  }

  .hero-eyebrow-text {
    font-size: 0.62rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--gold);
    font-weight: 600;
  }

  .hero-headline {
    font-family: 'Playfair Display', serif;
    font-size: 3.4rem;
    font-weight: 700;
    line-height: 1.08;
    color: var(--white);
    margin-bottom: 28px;
  }

  .hero-headline em {
    font-style: italic;
    color: var(--gold);
  }

  .hero-body {
    font-size: 1rem;
    line-height: 1.85;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 36px;
    font-weight: 300;
  }

  .hero-btns {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .hero-photo-card {
    background: var(--navy);
    border: 1px solid rgba(201, 168, 76, 0.2);
    position: relative;
    overflow: hidden;
  }

  .hero-photo-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--crimson), var(--gold));
    z-index: 2;
  }

  .hero-photo {
    width: 100%;
    display: block;
    filter: contrast(1.02) saturate(0.95);
  }

  .hero-photo-badge {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgba(20, 30, 43, 0.98) 0%, transparent 100%);
    padding: 32px 24px 24px;
  }

  .hero-photo-name {
    font-family: 'Playfair Display', serif;
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--white);
    margin-bottom: 4px;
  }

  .hero-photo-title {
    font-size: 0.55rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
    font-weight: 600;
  }

  /* ── STATS BAR ── */
  .stats-bar {
    background: var(--navy);
    padding: 60px 32px;
    border-top: 1px solid rgba(201, 168, 76, 0.15);
    border-bottom: 1px solid rgba(201, 168, 76, 0.15);
  }

  .stats-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    text-align: center;
  }

  .stat-block {
    border-right: 1px solid rgba(255, 255, 255, 0.08);
  }

  .stat-block:last-child { border-right: none; }

  .stat-num {
    font-family: 'Playfair Display', serif;
    font-size: 3rem;
    font-weight: 700;
    color: var(--gold);
    line-height: 1;
    margin-bottom: 8px;
  }

  .stat-num span {
    color: var(--crimson);
    font-size: 2rem;
  }

  .stat-text {
    font-size: 0.65rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
    font-weight: 600;
    line-height: 1.5;
  }

  /* ── THESIS GRID ── */
  .thesis-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    background: var(--border);
    margin-top: 48px;
  }

  .thesis-card {
    background: var(--white);
    padding: 44px 36px;
    position: relative;
    border-top: 4px solid transparent;
    transition: border-color 0.2s;
  }

  .thesis-card:hover { border-top-color: var(--crimson); }

  .thesis-num {
    font-family: 'Playfair Display', serif;
    font-size: 2.6rem;
    font-weight: 700;
    color: var(--gold);
    line-height: 1;
    margin-bottom: 16px;
  }

  .thesis-headline {
    font-family: 'Playfair Display', serif;
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--navy);
    margin-bottom: 14px;
    line-height: 1.25;
  }

  .thesis-body {
    font-size: 0.9rem;
    line-height: 1.75;
    color: #555;
    font-weight: 400;
  }

  /* ── CRITERIA TABLE ── */
  .criteria-table {
    margin-top: 48px;
    border: 1px solid var(--border);
    background: var(--white);
  }

  .criteria-row {
    display: grid;
    grid-template-columns: 240px 1fr;
    border-bottom: 1px solid var(--border);
  }

  .criteria-row:last-child { border-bottom: none; }

  .criteria-label {
    background: var(--off-white);
    padding: 22px 28px;
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--navy);
    font-weight: 700;
    border-right: 1px solid var(--border);
    display: flex;
    align-items: center;
  }

  .criteria-value {
    padding: 22px 28px;
    font-size: 0.95rem;
    color: var(--charcoal);
    line-height: 1.6;
    font-weight: 400;
    display: flex;
    align-items: center;
  }

  .criteria-value strong {
    color: var(--navy);
    font-weight: 600;
  }

  /* ── TIMELINE ── */
  .timeline {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin-top: 48px;
  }

  .timeline-step {
    position: relative;
    padding: 0 16px;
  }

  .timeline-step::before {
    content: '';
    position: absolute;
    top: 22px;
    right: -20px;
    width: 16px;
    height: 1px;
    background: rgba(255, 255, 255, 0.15);
  }

  .timeline-step:last-child::before { display: none; }

  .timeline-num {
    width: 44px;
    height: 44px;
    background: rgba(255, 255, 255, 0.06);
    color: var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Playfair Display', serif;
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 18px;
    border: 1px solid rgba(201, 168, 76, 0.3);
  }

  .timeline-headline {
    font-family: 'Playfair Display', serif;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--white);
    margin-bottom: 10px;
    line-height: 1.3;
  }

  .timeline-body {
    font-size: 0.85rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.7);
    font-weight: 400;
  }

  /* ── FORM SECTION (DARK) ── */
  .form-section {
    background: var(--navy-deep);
    padding: 100px 32px;
    color: var(--white);
    position: relative;
    overflow: hidden;
  }

  .form-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(201, 168, 76, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(201, 168, 76, 0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    pointer-events: none;
  }

  .form-inner {
    max-width: 720px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
    text-align: center;
  }

  .form-inner :global(.section-eyebrow) { justify-content: center; }
  .form-inner :global(.section-eyebrow-text) { color: var(--gold); }

  .form-inner :global(.section-headline) {
    color: var(--white);
    font-size: 2.4rem;
    margin-bottom: 16px;
  }

  .form-inner :global(.section-headline em) { color: var(--gold); }

  .form-inner :global(.section-sub) {
    color: rgba(255, 255, 255, 0.8);
    text-align: center;
    margin: 0 auto 48px;
    font-weight: 300;
    max-width: 100%;
  }

  .form-inner :global(.form-label) { color: var(--gold); }

  .form-inner :global(.form-input),
  .form-inner :global(.form-select) {
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--white);
    background: rgba(255, 255, 255, 0.05);
    padding: 14px 16px;
    font-size: 0.9rem;
  }

  .form-inner :global(.form-input::placeholder) {
    color: rgba(255, 255, 255, 0.35);
  }

  .form-inner :global(.form-input:focus),
  .form-inner :global(.form-select:focus) {
    border-color: var(--gold);
    background: rgba(255, 255, 255, 0.08);
  }

  .form-inner :global(.form-select option) {
    background: var(--navy);
    color: white;
  }

  .form-inner :global(.form-submit) {
    background: var(--crimson);
    font-size: 0.65rem;
    letter-spacing: 0.24em;
    padding: 20px;
    margin-top: 12px;
  }

  .form-inner :global(.form-submit:hover) { background: var(--crimson-light); }

  .form-inner :global(.form-disclaimer) {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.7rem;
    margin-top: 24px;
    font-weight: 300;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 1024px) {
    .hero-inner { grid-template-columns: 1fr; gap: 56px; }
    .hero-left, .hero-photo-card { grid-column: 1; grid-row: auto; }
    .hero-photo-card { max-width: 320px; margin: 0 auto; }
    .thesis-grid { grid-template-columns: 1fr; gap: 16px; background: transparent; }
    .timeline { grid-template-columns: repeat(2, 1fr); gap: 32px; }
    .timeline-step::before { display: none; }
    .stats-inner { grid-template-columns: repeat(2, 1fr); gap: 40px; }
    .stat-block:nth-child(2) { border-right: none; }
  }

  @media (max-width: 768px) {
    .hero { padding: 100px 24px 60px; }
    .hero-headline { font-size: 2.3rem; }
    .hero-body { font-size: 0.95rem; }
    .hero-btns { flex-direction: column; align-items: stretch; }
    .hero-btns :global(a) { text-align: center; }

    .thesis-card { padding: 32px 24px; }
    .thesis-num { font-size: 2.2rem; }
    .thesis-headline { font-size: 1.25rem; }

    .criteria-row { grid-template-columns: 1fr; }
    .criteria-label {
      border-right: none;
      border-bottom: 1px solid var(--border);
      padding: 14px 20px;
      font-size: 0.6rem;
    }
    .criteria-value { padding: 16px 20px; font-size: 0.9rem; }

    .timeline { grid-template-columns: 1fr; gap: 28px; }

    .stats-bar { padding: 40px 20px; }
    .stats-inner { grid-template-columns: 1fr; gap: 32px; }
    .stat-block {
      border-right: none;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      padding-bottom: 32px;
    }
    .stat-block:last-child { border-bottom: none; padding-bottom: 0; }
    .stat-num { font-size: 2.6rem; }

    .form-section { padding: 70px 20px; }
    .form-inner :global(.section-headline) { font-size: 1.8rem; }
