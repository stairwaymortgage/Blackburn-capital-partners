---
const items = [
  { headline: 'Scotsman Guide Top 1%', sub: 'Seven Consecutive Years' },
  { headline: 'Licensed', sub: 'Florida Mortgage Broker' },
  { headline: 'Capital Markets', sub: 'Fort Lauderdale, FL' },
];
---
<div class="creds-strip">
  <div class="creds-inner">
    {items.map((item) => (
      <div class="cred-item">
        <div class="cred-icon"></div>
        <div class="cred-body">
          <div class="cred-headline">{item.headline}</div>
          <div class="cred-sub">{item.sub}</div>
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .creds-strip {
    background: var(--navy);
    border-top: 1px solid rgba(201, 168, 76, 0.12);
    border-bottom: 1px solid rgba(201, 168, 76, 0.12);
    padding: 32px 32px;
  }

  .creds-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    flex-wrap: wrap;
  }

  .cred-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 8px 40px;
    border-right: 1px solid rgba(255, 255, 255, 0.08);
  }

  .cred-item:last-child { border-right: none; }

  .cred-icon {
    width: 7px;
    height: 7px;
    background: var(--crimson);
    transform: rotate(45deg);
    flex-shrink: 0;
  }

  .cred-body {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .cred-headline {
    font-family: 'Playfair Display', serif;
    font-size: 0.95rem;
    color: var(--gold);
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
  }

  .cred-sub {
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
    font-weight: 500;
    line-height: 1.3;
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .creds-strip { padding: 40px 16px; }
    .creds-inner { flex-direction: column; gap: 0; }
    .cred-item {
      border-right: none;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      width: 100%;
      max-width: 360px;
      justify-content: flex-start;
      padding: 24px 0;
      gap: 20px;
    }
    .cred-item:last-child { border-bottom: none; }
    .cred-icon { width: 10px; height: 10px; }
    .cred-headline { font-size: 1.4rem; }
    .cred-sub { font-size: 0.7rem; letter-spacing: 0.16em; }
  }
</style>
