---
interface QuickLink {
  label: string;
  href: string;
}

interface Props {
  quickLinks?: QuickLink[];
  emailLinkHref?: string;
}

const {
  quickLinks = [
    { label: 'Hotel Deals', href: '/#deals' },
    { label: 'Investor Network', href: '/#investors' },
    { label: 'About Our Team', href: '/#about' },
    { label: 'Our Territory', href: '/#territory' },
    { label: 'Get Started', href: '/start' },
  ],
  emailLinkHref = '#contact',
} = Astro.props;

const brands = [
  { name: 'Blackburn Business Capital', parent: 'Commercial Capital Brokerage' },
  { name: 'Blackburn Realty Group', parent: 'A Division of The Keyes Company' },
  { name: 'Stairway Mortgage', parent: 'A Division of Nexa Mortgage' },
];
---
<footer>
  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-brand-block">
        <div class="footer-logo">Blackburn Capital Partners</div>
        <p class="footer-tagline">
          Private hotel acquisition deal flow across the Sun Belt Coastal Crescent.
          Fort Lauderdale, Florida.
        </p>
        <div class="footer-contact">
          <a href="tel:9548241894">(954) 824-1894</a>
          <a href={emailLinkHref}>Email Us</a>
        </div>
      </div>

      <div>
        <div class="footer-col-title">Quick Links</div>
        <ul class="footer-links">
          {quickLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <div class="footer-col-title">Our Industry Presence</div>
        <ul class="brand-list">
          {brands.map((brand) => (
            <li class="brand-item">
              <div class="brand-name">{brand.name}</div>
              <div class="brand-parent">{brand.parent}</div>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="footer-copy">
        &copy; 2026 Blackburn Capital Partners &middot; Fort Lauderdale, Florida
      </div>
      <div class="footer-legal">
        This website is for informational purposes only and does not constitute an offer
        to sell or solicitation of an offer to buy any security. All investment
        opportunities are presented exclusively to qualified accredited investors.
      </div>
    </div>
  </div>
</footer>

<style>
  footer {
    background: #0A0E14;
    padding: 60px 32px 40px;
    border-top: 1px solid rgba(201, 168, 76, 0.1);
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 48px;
    margin-bottom: 48px;
    padding-bottom: 48px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .footer-brand-block {
    display: flex;
    flex-direction: column;
  }

  .footer-logo {
    font-family: 'Playfair Display', serif;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--white);
    margin-bottom: 12px;
  }

  .footer-tagline {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.8;
    font-weight: 300;
    max-width: 280px;
    margin-bottom: 18px;
  }

  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .footer-contact a {
    font-size: 0.78rem;
    color: var(--gold);
    text-decoration: none;
    font-weight: 500;
    letter-spacing: 0.03em;
    transition: color 0.2s;
  }

  .footer-contact a:hover { color: var(--gold-light); }

  .footer-col-title {
    font-size: 0.58rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold);
    font-weight: 700;
    margin-bottom: 20px;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-links a {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    font-weight: 400;
    transition: color 0.2s;
    letter-spacing: 0.03em;
  }

  .footer-links a:hover { color: var(--white); }

  .brand-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .brand-item {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .brand-name {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.85);
    font-weight: 500;
    letter-spacing: 0.02em;
    font-family: 'Playfair Display', serif;
  }

  .brand-parent {
    font-size: 0.62rem;
    color: rgba(255, 255, 255, 0.4);
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-style: italic;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }

  .footer-copy {
    font-size: 0.68rem;
    color: rgba(255, 255, 255, 0.45);
    font-weight: 400;
    letter-spacing: 0.05em;
  }

  .footer-legal {
    font-size: 0.62rem;
    color: rgba(255, 255, 255, 0.4);
    font-weight: 400;
    max-width: 500px;
    line-height: 1.7;
    text-align: right;
  }

  @media (max-width: 768px) {
    footer { padding: 48px 20px 32px; }
    .footer-top {
      grid-template-columns: 1fr;
      gap: 36px;
      margin-bottom: 36px;
      padding-bottom: 36px;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      text-align: left;
    }
    .footer-legal { text-align: left; font-size: 0.6rem; }
  }
</style>
